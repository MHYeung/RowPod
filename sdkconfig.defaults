# Use the ESP32-C3's native USB Serial/JTAG controller for console I/O.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Stage 6 — NimBLE advertise-only RF bring-up
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
# Prefer large ATT MTU so 22-byte v16 frames + batching can fit when the
# central (Chrome/OS) actually completes Exchange MTU. Windows often stays 23.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
