# Use the ESP32-C3's native USB Serial/JTAG controller for console I/O.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Deep-sleep wake re-checks the image unless this is set. That check eats
# the 2 s button-hold window measured from esp_timer in power_boot_gate().
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# Stage 6 — NimBLE advertise-only RF bring-up
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
# Prefer large ATT MTU so 24-byte fused (or 22-byte v16) batches can fit when
# the central (Chrome/OS) actually completes Exchange MTU. Windows often stays 23.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
